# WebSocket API address supplied by the organizers.
DOME_URL=
DOME_KEY=
AGENT_LOG_DIR=logs
DOME_CONNECT_TIMEOUT=15
DOME_REQUEST_TIMEOUT=15
DOME_IDLE_TIMEOUT=20
DOME_RECONNECT_DELAY=5
DOME_PING_INTERVAL=30
# Optional: explicit WebSocket route, e.g. /ws. Leave empty for the given URL path.
DOME_WS_PATH=
# Optional local SOCKS/HTTP tunnel, e.g. socks5://127.0.0.1:10808
DOME_PROXY=
